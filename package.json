{
  "name": "flowingdocs",
  "version": "3.9.2",
  "description": "A modern blog and documentation starter template built on Docusaurus v3",
  "keywords": [
    "docusaurus",
    "blog",
    "technical communication",
    "react",
    "tailwindcss",
    "starter",
    "technical writing"
  ],
  "author": {
    "url": "https://github.com/heywalter",
    "email": "walter@flowingdocs.com",
    "name": "Walter Gui"
  },
  "repository": {
    "url": "https://github.com/heywalter/flowingdocs",
    "type": "git"
  },
  "homepage": "https://flowingdocs.com",
  "license": "MIT",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "start:en": "docusaurus start --locale en",
    "build": "docusaurus build",
    "prebuild": "node scripts/generate-thumbnails.mjs && node scripts/build-publishing-starter.mjs && node scripts/generate-llms-txt.mjs",
    "llms": "node scripts/generate-llms-txt.mjs",
    "thumbs": "node scripts/generate-thumbnails.mjs",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear && rimraf changelog",
    "serve": "docusaurus serve",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "test:markup": "node scripts/test-markup-workshop.mjs",
    "test:publishing": "node scripts/test-publishing-starter.mjs",
    "check:docs-links": "node scripts/check-doc-links.mjs",
    "check:site-links": "node scripts/check-doc-links.mjs build --all",
    "typecheck": "tsc --noEmit",
    "test:navigation": "node scripts/test-site-navigation.mjs",
    "test:ai-content": "node scripts/test-ai-content.mjs",
    "check:release": "pnpm lint && pnpm typecheck && pnpm test:markup && pnpm test:navigation && pnpm test:publishing && pnpm build && pnpm test:blog && pnpm check:site-links && pnpm test:ai-content build",
    "test:blog": "node scripts/test-blog-browsing.mjs build"
  },
  "dependencies": {
    "@asciidoctor/core": "3.0.4",
    "@docusaurus/core": "3.9.2",
    "@docusaurus/plugin-content-blog": "^3.9.2",
    "@docusaurus/plugin-ideal-image": "3.9.2",
    "@docusaurus/plugin-pwa": "3.9.2",
    "@docusaurus/plugin-vercel-analytics": "^3.9.2",
    "@docusaurus/preset-classic": "3.9.2",
    "@docusaurus/theme-classic": "3.9.2",
    "@docusaurus/theme-common": "^3.9.2",
    "@docusaurus/theme-mermaid": "3.9.2",
    "@docusaurus/theme-search-algolia": "3.9.2",
    "@docusaurus/utils-common": "^3.9.2",
    "@giscus/react": "^3.1.0",
    "@popperjs/core": "^2.11.8",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-slot": "^1.1.1",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "copy-text-to-clipboard": "^3.2.2",
    "docusaurus-plugin-image-zoom": "^2.0.0",
    "dompurify": "3.4.16",
    "framer-motion": "^12.34.2",
    "hast-util-to-html": "9.0.5",
    "mdast-util-from-markdown": "2.0.2",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-hast": "13.2.1",
    "micromark-extension-gfm": "3.0.0",
    "mini-svg-data-uri": "^1.4.4",
    "ora": "^8.1.1",
    "parse5": "7.3.0",
    "postcss": "^8.5.1",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "raw-loader": "^4.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-github-calendar": "^4.5.4",
    "react-popper": "^2.3.0",
    "react-tweet": "^3.2.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.9.2",
    "@docusaurus/tsconfig": "^3.9.2",
    "@docusaurus/types": "3.9.2",
    "@stylistic/eslint-plugin": "2.13.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/gtag.js": "0.0.12",
    "@types/mdast": "4.0.4",
    "@types/react": "19.2.14",
    "@types/three": "0.180.0",
    "@typescript-eslint/eslint-plugin": "8.20.0",
    "eslint": "9.18.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-tailwindcss": "3.18.0",
    "gray-matter": "4.0.3",
    "mdast-util-to-markdown": "2.1.2",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "engines": {
    "node": ">=20.0"
  },
  "packageManager": "pnpm@9.15.4"
}
